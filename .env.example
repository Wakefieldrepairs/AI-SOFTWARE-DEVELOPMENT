# =============================================================================
# Application Environment Variables Template
# Copy this file to .env and configure local values as needed.
# =============================================================================

# Application Server Configuration
APP_NAME="AI Agent Platform"
APP_ENV="development"          # development | staging | production
API_HOST="0.0.0.0"
API_PORT=8000
STREAMLIT_PORT=8501
LOG_LEVEL="INFO"               # DEBUG | INFO | WARNING | ERROR | CRITICAL

# LLM Configuration (OpenAI / Ollama / Local vLLM / LiteLLM)
LLM_BASE_URL="http://localhost:11434/v1"
LLM_API_KEY="ollama"
LLM_DEFAULT_MODEL="llama3.2:latest"
LLM_FALLBACK_MODEL="llama3.2:1b"
LLM_TIMEOUT_SECONDS=60.0
LLM_MAX_RETRIES=3
LLM_DEFAULT_TEMPERATURE=0.7
LLM_DEFAULT_MAX_TOKENS=2048

# CORS Settings (comma-separated origins)
CORS_ORIGINS="*"
# Placeholder credentials
OPENAI_API_KEY="your_key_here"
ANTHROPIC_API_KEY="your_key_here"
GEMINI_API_KEY="your_key_here"
